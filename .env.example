# 无 Key 可使用标识清楚的 Mock 练习。真实模型可使用平台 Key 或前端「模型与 API」BYOK。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 留空使用默认值，也可配置你的账号支持的模型。
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=12
LLM_CONCURRENCY=4
# 不设置时保存到项目 data/werewolf.sqlite3
# DATABASE_PATH=/var/data/werewolf.sqlite3
# 只运行一个 worker / 一个服务实例。
# PORT=8000
# 阿里云百炼 / 通义千问（OpenAI 兼容接口）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 同一 Provider 可注册多个真正的模型 ID；只填写账号可用的项。
# 严格模式下，每个真实 AI 座位需要一个独立模型。Mock 练习座位可复用。
# DASHSCOPE_MODELS=qwen-plus,qwen-turbo,qwen-max,qwen-flash,qwen3-max
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# AI_MODEL_REGISTRY=[{"provider":"dashscope","model":"qwen-plus","enabled":true,"capabilities":["chat","json","stream"]}]
LLM_RETRIES=1
LLM_RETRY_DELAY=0.2
LLM_MODEL_COOLDOWN=20

# 限流 / 预算：每个真实 HTTP 尝试（包括重试、故障切换）均计数。
RATE_SESSION_PER_MINUTE=20
RATE_ROOM_PER_HOUR=10
RATE_PET_PER_MINUTE=12
RATE_ROOM_AI_PER_MINUTE=180
AI_GAME_MAX_REQUESTS=300
AI_GAME_TOKEN_BUDGET=250000
AI_DAILY_TOKEN_BUDGET=2000000
MAX_ACTIVE_ROOMS=20
# 价格为自定义货币单位 / 百万 tokens；0 表示不启用货币限额，token限额仍有效。
AI_GAME_COST_BUDGET=0
AI_DAILY_COST_BUDGET=0
# AI_MODEL_PRICES={"dashscope:qwen-plus":{"input":0.8,"output":2.0}}
# 生命周期：仅无连接且非ACTIVE的房间可卸载；归档后的完整数据有保留期，超过期限真正删除。
ROOM_IDLE_UNLOAD_SECONDS=300
ROOM_LOBBY_TTL_HOURS=6
ROOM_FINISHED_TTL_DAYS=14
SESSION_TTL_DAYS=30

# V3：token / memory / 自主模型推理
TOKEN_SAFETY_MARGIN=1.15
AI_PROMPT_TOKEN_LIMIT=6000
# tiktoken 第一次使用可能下载公共词表；可通过可写缓存目录预热。
# TIKTOKEN_CACHE_DIR=/var/cache/tiktoken

# 房间和会话两个维度分别限流，每个窗口为 60 秒。0 禁用对应限流。
RATE_JOIN_PER_MINUTE=30
RATE_CHAT_PER_MINUTE=60
RATE_ACTION_PER_MINUTE=90
RATE_RECONNECT_PER_MINUTE=30
RATE_MODEL_TEST_PER_MINUTE=6
RATE_RECOVERY_PER_MINUTE=10
# ARCHIVED 的聊天、私有记忆、事件和模型记录保留 14 天，然后只留下匿名统计。
ROOM_ARCHIVED_RETENTION_DAYS=14

# V3 BYOK：留空则生成 data/ 下权限600的加密密钥文件；数据库和密钥需一起备份。
# 如手动设置，使用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=
# AI完成后只允许短暂阅读停顿，不等待阶段倒计时；设置0立即推进。
AI_TURN_PAUSE=0.4
